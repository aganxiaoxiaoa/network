#Requires -Version 5.1
<#
  auto_network_recovery.ps1  (v2, rewritten 2026-08-09)
  Conservative network watchdog for a Wi-Fi-only laptop running Clash Verge (verge-mihomo)
  in SYSTEM-PROXY mode, plus ProxyBridge.

  DO NOT launch this file directly with `powershell -file`. Use manage_watchdog.ps1 -Install
  so exactly one instance ever runs. See README.md for why (v1 caused two independent AI
  sessions to each start a copy, which fought over the Wi-Fi adapter and caused real outages).

  What changed from v1 and why:
    - Single-instance Mutex lock. v1 had no lock; two ad-hoc copies (started by two different
      AI sessions on 2026-08-09) each independently decided the network was down and each
      cycled the Wi-Fi adapter, which is what actually caused that day's outages.
    - Gateway ping is no longer, by itself, grounds to cycle the NIC. A busy/slow router can
      miss one ping without the WAN being down; v1 used exactly that single noisy signal to
      justify its most destructive action.
    - Adds a real WAN-reachability check (two independent public IPs, raw TCP, bypasses the
      system proxy) so "gateway is slow" and "internet is actually gone" are no longer treated
      as the same event.
    - Adds mihomo-aware diagnosis: most of this laptop's real-world "no internet" moments are
      a single Clash proxy node timing out, not the Wi-Fi being down (confirmed via screenshots
      showing many nodes in "Timeout" state). The old script could only restart the *entire*
      proxy stack; it had no way to just switch to a healthy node. v2 queries the local mihomo
      HTTP API (external-controller in config.yaml) and, if the active node in a group is dead,
      re-tests the group and switches to the fastest healthy member -- no process kill, no
      dropped connections for anything not using that one bad node.
    - Three independent recovery tracks (link/WAN, proxy-process, proxy-node) each with their
      own cooldown, instead of one linear escalation. A dead proxy node no longer has to wait
      behind -- or trigger -- a Wi-Fi adapter cycle.
    - NIC cycling is now gated on adapter-down OR both-public-targets-unreachable, sustained
      across $FailuresBeforeRecovery consecutive checks. Gateway ping alone can no longer
      trigger it.
    - Log file rotates once it exceeds ~5MB instead of growing forever.

  Fixes applied 2026-08-09 after the v2 install itself caused a real outage:
    - Startup grace period ($StartupGraceSeconds, default 60s): a freshly (re)started instance
      no longer counts link/WAN failures toward the NIC-cycle threshold. Observed failure mode:
      the watchdog process was killed and restarted twice (19:08, 19:10; Scheduled Task showed
      LastTaskResult 3221225786 = STATUS_CONTROL_C_EXIT), and each fresh restart raced 3
      consecutive failures within 46 seconds and cycled the Wi-Fi adapter -- with no proof the
      link was ever actually down. The killer of the watchdog process itself is still unconfirmed.
    - Fixed mojibake: PowerShell 5.1's Invoke-RestMethod decodes mihomo's JSON response as
      Latin-1 when no charset is declared, mangling any non-ASCII proxy/group name. This made
      Repair-MihomoGroup 404 forever on Chinese/emoji-named groups. Now reversed via Fix-Mojibake
      before the name is used to build API URLs or PUT bodies.

  Verified environment (2026-08-09):
    WLAN adapter      : MediaTek Wi-Fi 6E MT7922, interface alias "WLAN"
    Gateway           : 192.168.0.1
    Proxy mixed port  : 7897 (verge-mihomo, used by apps)
    mihomo controller : read at runtime from Clash Verge's config.yaml (currently 127.0.0.1:9097)
    Processes         : clash-verge, verge-mihomo, ProxyBridge (D:\软件\VPN\代理\)
#>

[CmdletBinding()]
param(
    [int]      $IntervalSeconds        = 15,
    [string]   $Gateway                = '192.168.0.1',
    [int]      $ProxyPort              = 7897,
    [string]   $ProxyHost              = '127.0.0.1',
    [string[]] $PublicWanTargets       = @('223.5.5.5:53', '1.1.1.1:53'),   # independent, bypass system proxy (raw TCP)
    [string]   $MihomoConfigPath       = "$env:APPDATA\io.github.clash-verge-rev.clash-verge-rev\config.yaml",
    [int]      $FailuresBeforeRecovery = 3,      # consecutive real link/WAN failures before NIC cycle
    [int]      $StartupGraceSeconds    = 60,     # ignore link/WAN failure streak until this long after (re)start
    [int]      $LinkCooldownSeconds    = 180,    # min gap between NIC cycles (most destructive action)
    [int]      $ProxyCooldownSeconds  = 90,      # min gap between proxy-stack restarts
    [int]      $NodeFixCooldownSeconds = 60,     # min gap between mihomo node-switch attempts
    # SHOP SAFETY: never auto-switch these groups. The user runs cross-border e-commerce store
    # windows (BitBrowser) through a paid UK RESIDENTIAL IP, pinned via rule-based split-routing
    # in Clash. The whole value of that residential IP is a STABLE, dedicated exit IP -- if the
    # watchdog "helpfully" switched this group to a faster node, it would rotate the store's exit
    # IP and risk account association/bans. Any group whose name matches this regex is treated as
    # a deliberate human pin and is NEVER re-tested or switched by this script.
    [string]   $ProtectedGroupRegex    = 'Residential|住宅|ISP|店铺|UK-Residential',
    [string]   $LogPath                = 'D:\agentNeural Network Knowledge Base\network\network_recovery.log',
    [long]     $LogRotateBytes         = 5MB,
    [switch]   $AllowProxyRegistryReset,          # OFF by default (destructive to session)
    [switch]   $RunOnce                            # single check pass, for testing
)

# --- single-instance guard --------------------------------------------------
$script:MutexName = 'Global\NetworkRecoveryWatchdog'
$script:CreatedNew = $false
$script:Mutex = New-Object System.Threading.Mutex($true, $script:MutexName, [ref]$script:CreatedNew)

# --- process / path config -------------------------------------------------
$ProxyProcNames = @('verge-mihomo', 'clash-verge', 'ProxyBridge')
$ProxyExePaths  = @{
    'clash-verge'  = 'D:\软件\VPN\代理\clash-verge.exe'
    'verge-mihomo' = 'D:\软件\VPN\代理\verge-mihomo.exe'
    'ProxyBridge'  = 'D:\软件\VPN\代理\ProxyBridge\ProxyBridge.exe'
}

$script:LastLinkRecovery  = [datetime]::MinValue
$script:LastProxyRecovery = [datetime]::MinValue
$script:LastNodeFix       = [datetime]::MinValue
$script:LinkFailStreak    = 0
$script:StartTime         = Get-Date

function Write-Log {
    param([string]$Level, [string]$Message)
    $ts   = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
    $line = "[$ts] [$Level] $Message"
    try {
        $dir = Split-Path -Parent $LogPath
        if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
        if ((Test-Path $LogPath) -and ((Get-Item $LogPath).Length -gt $LogRotateBytes)) {
            $rotated = "$LogPath.1"
            if (Test-Path $rotated) { Remove-Item $rotated -Force -ErrorAction SilentlyContinue }
            Move-Item -Path $LogPath -Destination $rotated -Force -ErrorAction SilentlyContinue
        }
        Add-Content -Path $LogPath -Value $line -Encoding UTF8
    } catch { }
    Write-Host $line
}

if (-not $script:CreatedNew) {
    Write-Log 'FATAL' 'Another instance already holds the watchdog mutex. Exiting so we do not fight it over the Wi-Fi adapter.'
    return
}

# --- mihomo API helpers ------------------------------------------------------
$script:MihomoBase   = $null
$script:MihomoHeaders = @{}

function Initialize-MihomoApi {
    try {
        if (-not (Test-Path $MihomoConfigPath)) { Write-Log 'WARN' "mihomo config not found: $MihomoConfigPath"; return $false }
        $raw = Get-Content -Path $MihomoConfigPath -Raw
        $ctrlMatch = [regex]::Match($raw, "(?m)^external-controller:\s*['""]?([^\s'""]+)")
        $secretMatch = [regex]::Match($raw, "(?m)^secret:\s*['""]?([^\s'""]*)")
        if (-not $ctrlMatch.Success -or [string]::IsNullOrWhiteSpace($ctrlMatch.Groups[1].Value)) {
            Write-Log 'WARN' 'mihomo external-controller not set in config; node-health checks disabled.'
            return $false
        }
        $script:MihomoBase = "http://$($ctrlMatch.Groups[1].Value)"
        $script:MihomoHeaders = @{}
        if ($secretMatch.Success -and -not [string]::IsNullOrWhiteSpace($secretMatch.Groups[1].Value)) {
            $script:MihomoHeaders['Authorization'] = "Bearer $($secretMatch.Groups[1].Value)"
        }
        return $true
    } catch {
        Write-Log 'ERROR' "Initialize-MihomoApi failed: $($_.Exception.Message)"
        return $false
    }
}

# Windows PowerShell 5.1's Invoke-RestMethod decodes the HTTP response as ISO-8859-1 when
# mihomo's JSON response doesn't declare a charset, so any non-ASCII proxy/group name (Chinese,
# emoji) comes back mangled. The corruption is a clean 1-byte-per-char mapping, so it is
# reversible: reinterpret the mangled string's codepoints as Latin-1 bytes, then decode those
# bytes as UTF-8 to recover the original text. Without this, group/node names containing
# non-ASCII characters can never be matched against mihomo's real API (confirmed: repeated
# 404s trying to repair a Chinese-named group on 2026-08-09).
function Fix-Mojibake {
    param([string]$Text)
    if ([string]::IsNullOrEmpty($Text)) { return $Text }
    try { return [System.Text.Encoding]::UTF8.GetString([System.Text.Encoding]::GetEncoding('ISO-8859-1').GetBytes($Text)) }
    catch { return $Text }
}

function Test-MihomoReachable {
    if (-not $script:MihomoBase) { return $false }
    try {
        Invoke-RestMethod -Uri "$($script:MihomoBase)/version" -Headers $script:MihomoHeaders -TimeoutSec 3 -ErrorAction Stop | Out-Null
        return $true
    } catch { return $false }
}

# Returns an array of group names (Selector/URLTest/Fallback/LoadBalance) whose currently
# active member's most recent delay test failed (no history, or last delay == 0).
function Get-UnhealthyMihomoGroups {
    if (-not $script:MihomoBase) { return @() }
    try {
        $resp = Invoke-RestMethod -Uri "$($script:MihomoBase)/proxies" -Headers $script:MihomoHeaders -TimeoutSec 5 -ErrorAction Stop
        $proxies = $resp.proxies
        $unhealthy = @()
        foreach ($name in $proxies.PSObject.Properties.Name) {
            $group = $proxies.$name
            # Only automatic groups. Selectors are deliberate human choices (incl. the residential
            # shop pin) -- never override them. Re-testing a url-test/fallback group just refreshes
            # its own auto-selection; it can't move a Selector's pinned exit.
            if ($group.type -notin @('URLTest', 'Fallback', 'LoadBalance')) { continue }
            $fixedName = Fix-Mojibake $name
            if ($fixedName -match $ProtectedGroupRegex) { continue }
            if (-not $group.now) { continue }
            $current = $proxies.($group.now)
            if (-not $current) { continue }
            $hist = $current.history
            $lastDelay = $null
            if ($hist -and $hist.Count -gt 0) { $lastDelay = $hist[-1].delay }
            if (-not $lastDelay -or $lastDelay -le 0) { $unhealthy += $fixedName }
        }
        return $unhealthy
    } catch {
        Write-Log 'ERROR' "Get-UnhealthyMihomoGroups failed: $($_.Exception.Message)"
        return @()
    }
}

# Every switchable group name (mojibake-fixed). Used when a real request through the proxy
# fails: at that point we can't trust the cached per-node delay history (this subscription
# sets the auto-test interval to 24h, so the "last delay" reading can be a full day stale and
# still show a healthy number for a node that is actually dead). So we force a fresh re-test on
# all groups -- the programmatic equivalent of clicking "refresh" in Clash Verge.
function Get-AllProxyGroups {
    if (-not $script:MihomoBase) { return @() }
    try {
        $resp = Invoke-RestMethod -Uri "$($script:MihomoBase)/proxies" -Headers $script:MihomoHeaders -TimeoutSec 5 -ErrorAction Stop
        $proxies = $resp.proxies
        $groups = @()
        foreach ($name in $proxies.PSObject.Properties.Name) {
            $group = $proxies.$name
            # Automatic groups only, and never a protected (shop/residential) group -- see the
            # $ProtectedGroupRegex note in param(). We force-refresh general-browsing auto groups;
            # we do not touch human-pinned Selectors or the residential exit.
            if ($group.type -in @('URLTest', 'Fallback', 'LoadBalance') -and $group.now) {
                $fixedName = Fix-Mojibake $name
                if ($fixedName -notmatch $ProtectedGroupRegex) { $groups += $fixedName }
            }
        }
        return $groups
    } catch {
        Write-Log 'ERROR' "Get-AllProxyGroups failed: $($_.Exception.Message)"
        return @()
    }
}

function Repair-MihomoGroup {
    param([string]$GroupName)
    # Last-line shop safety: even if a protected group somehow reaches here, never switch it.
    if ($GroupName -match $ProtectedGroupRegex) {
        Write-Log 'INFO' "Skipping protected group '$GroupName' (shop/residential pin -- never auto-switched)."
        return
    }
    try {
        $encoded = [uri]::EscapeDataString($GroupName)
        $delayUri = "$($script:MihomoBase)/group/$encoded/delay?url=$([uri]::EscapeDataString('https://www.gstatic.com/generate_204'))&timeout=5000"
        $results = Invoke-RestMethod -Uri $delayUri -Headers $script:MihomoHeaders -TimeoutSec 8 -ErrorAction Stop
        # $results is a name -> delay(ms) map for members that responded; members that timed out are absent.
        $best = $results.PSObject.Properties | Where-Object { $_.Value -gt 0 } | Sort-Object Value | Select-Object -First 1
        if (-not $best) {
            Write-Log 'WARN' "Group '$GroupName' re-test found no healthy member."
            return
        }
        $bestName = Fix-Mojibake $best.Name
        $groupInfo = Invoke-RestMethod -Uri "$($script:MihomoBase)/proxies/$encoded" -Headers $script:MihomoHeaders -TimeoutSec 5 -ErrorAction Stop
        if ($groupInfo.type -eq 'Selector') {
            $bodyBytes = [System.Text.Encoding]::UTF8.GetBytes((@{ name = $bestName } | ConvertTo-Json -Compress))
            Invoke-RestMethod -Uri "$($script:MihomoBase)/proxies/$encoded" -Headers $script:MihomoHeaders -Method Put -Body $bodyBytes -ContentType 'application/json; charset=utf-8' -TimeoutSec 5 -ErrorAction Stop | Out-Null
            Write-Log 'ACTION' "Switched group '$GroupName' to '$bestName' ($($best.Value)ms)"
        } else {
            # URLTest/Fallback/LoadBalance auto-select from the delay cache we just refreshed; no PUT needed/allowed.
            Write-Log 'ACTION' "Re-tested auto-select group '$GroupName'; best member now '$bestName' ($($best.Value)ms)"
        }
    } catch {
        Write-Log 'ERROR' "Repair-MihomoGroup('$GroupName') failed: $($_.Exception.Message)"
    }
}

# --- health checks (layered) ------------------------------------------------
# Layer 0: is the adapter itself Up?
function Test-AdapterUp {
    try {
        $nic = Get-NetAdapter | Where-Object { $_.InterfaceDescription -match 'MT7922|Wi-Fi|Wireless' -and $_.Status -ne 'Not Present' } | Select-Object -First 1
        return ($nic -and $nic.Status -eq 'Up')
    } catch { return $false }
}

# Layer 1: gateway ping. Reference signal only -- NOT sufficient alone to trigger recovery.
function Test-GatewayAlive {
    try { return (Test-Connection -ComputerName $Gateway -Count 1 -Quiet -ErrorAction Stop) }
    catch { return $false }
}

# Layer 2: real WAN reachability. Raw TCP connect (bypasses system HTTP proxy settings) against
# two independent public targets. Only counts as "WAN down" if BOTH fail.
function Test-TcpTarget {
    param([string]$HostPort)
    $parts = $HostPort -split ':'
    $targetHost = $parts[0]; $targetPort = [int]$parts[1]
    try {
        $c = New-Object System.Net.Sockets.TcpClient
        $iar = $c.BeginConnect($targetHost, $targetPort, $null, $null)
        $ok  = $iar.AsyncWaitHandle.WaitOne(2000, $false)
        if ($ok -and $c.Connected) { $c.EndConnect($iar); $c.Close(); return $true }
        $c.Close(); return $false
    } catch { return $false }
}

function Test-PublicWan {
    $results = $PublicWanTargets | ForEach-Object { Test-TcpTarget -HostPort $_ }
    return ($results -contains $true)   # WAN OK if at least one independent target answers
}

# Layer 3a: is the local proxy mixed-port listener accepting connections?
function Test-ProxyPort {
    try {
        $c = New-Object System.Net.Sockets.TcpClient
        $iar = $c.BeginConnect($ProxyHost, $ProxyPort, $null, $null)
        $ok  = $iar.AsyncWaitHandle.WaitOne(2000, $false)
        if ($ok -and $c.Connected) { $c.EndConnect($iar); $c.Close(); return $true }
        $c.Close(); return $false
    } catch { return $false }
}

# Layer 3b: does traffic actually FLOW through the proxy? A listening port is NOT proof the
# active node works. This is the check that catches the real, most-common symptom on this
# laptop -- "nodes timed out, no internet until I click refresh in Clash." When the selected
# node dies, the mixed port stays open (Test-ProxyPort passes) and mihomo's cached delay stays
# stale-good for up to the group's test interval (24h in this subscription), so neither the port
# probe nor Get-UnhealthyMihomoGroups notices. A real HTTP request through the mixed port does.
function Test-ProxyInternet {
    try {
        $req = [System.Net.HttpWebRequest]::Create('http://cp.cloudflare.com/generate_204')
        $req.Proxy = New-Object System.Net.WebProxy("http://${ProxyHost}:${ProxyPort}")
        $req.Method = 'GET'
        $req.Timeout = 6000
        $req.ReadWriteTimeout = 6000
        $resp = $req.GetResponse()
        $code = [int]$resp.StatusCode
        $resp.Close()
        return ($code -ge 200 -and $code -lt 400)
    } catch { return $false }
}

# Layer 4: DNS resolution.
function Test-DnsResolves {
    try { Resolve-DnsName -Name 'www.microsoft.com' -Type A -QuickTimeout -ErrorAction Stop | Out-Null; return $true }
    catch { return $false }
}

# --- recovery actions --------------------------------------------------------
function Invoke-FlushDns {
    Write-Log 'ACTION' 'Flushing DNS cache (ipconfig /flushdns)'
    try { ipconfig /flushdns | Out-Null; return $true } catch { Write-Log 'ERROR' "flushdns failed: $($_.Exception.Message)"; return $false }
}

function Restart-ProxyStack {
    Write-Log 'ACTION' 'Restarting proxy stack (verge-mihomo / ProxyBridge / clash-verge)'
    foreach ($name in $ProxyProcNames) {
        try {
            $procs = Get-Process -Name $name -ErrorAction SilentlyContinue
            if ($procs) { $procs | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Log 'INFO' "Stopped $name" }
        } catch { Write-Log 'ERROR' "Stop $name failed: $($_.Exception.Message)" }
    }
    Start-Sleep -Seconds 2
    foreach ($name in @('clash-verge', 'ProxyBridge')) {
        $exe = $ProxyExePaths[$name]
        if ($exe -and (Test-Path $exe)) {
            try { Start-Process -FilePath $exe -ErrorAction Stop; Write-Log 'INFO' "Launched $name" }
            catch { Write-Log 'ERROR' "Launch $name failed: $($_.Exception.Message)" }
        } else { Write-Log 'WARN' "Exe not found for ${name}: $exe" }
    }
    Reset-ProxyRegistry   # no-op unless opt-in
}

function Reset-WlanAdapter {
    Write-Log 'ACTION' 'LAST RESORT: reconnecting Wi-Fi adapter'
    try {
        $nic = Get-NetAdapter | Where-Object { $_.InterfaceDescription -match 'MT7922|Wi-Fi|Wireless' -and $_.Status -ne 'Not Present' } | Select-Object -First 1
        if (-not $nic) { Write-Log 'ERROR' 'WLAN adapter not found'; return }
        Disable-NetAdapter -Name $nic.Name -Confirm:$false -ErrorAction Stop
        Start-Sleep -Seconds 3
        Enable-NetAdapter -Name $nic.Name -Confirm:$false -ErrorAction Stop
        Write-Log 'INFO' "Cycled adapter $($nic.Name)"
    } catch { Write-Log 'ERROR' "Adapter reset failed: $($_.Exception.Message)" }
}

function Reset-ProxyRegistry {
    if (-not $AllowProxyRegistryReset) { Write-Log 'INFO' 'Proxy registry reset skipped (opt-in flag not set)'; return }
    Write-Log 'ACTION' 'Re-asserting system proxy registry (opt-in)'
    try {
        $p = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings'
        Set-ItemProperty -Path $p -Name ProxyEnable -Value 1 -Type DWord
        Set-ItemProperty -Path $p -Name ProxyServer -Value "$ProxyHost`:$ProxyPort" -Type String
        Write-Log 'INFO' "Proxy registry set to $ProxyHost`:$ProxyPort"
    } catch { Write-Log 'ERROR' "Proxy registry reset failed: $($_.Exception.Message)" }
}

# --- diagnosis + escalation (three independent tracks, each with its own cooldown) -----------
function Invoke-CheckPass {
    $adapterUp = Test-AdapterUp
    $gatewayOk = if ($adapterUp) { Test-GatewayAlive } else { $false }
    $wanOk     = if ($adapterUp) { Test-PublicWan } else { $false }
    $proxyPortOk = if ($wanOk -or $gatewayOk) { Test-ProxyPort } else { $false }
    $mihomoOk    = if ($proxyPortOk) { Test-MihomoReachable } else { $false }
    $dnsOk       = if ($wanOk) { Test-DnsResolves } else { $false }

    $realLinkDown = (-not $adapterUp) -or (-not $wanOk)

    if ($realLinkDown) {
        $script:LinkFailStreak++
        Write-Log 'WARN' ("Link/WAN check failed (adapterUp={0} gatewayOk={1} wanOk={2}) streak={3}/{4}" -f $adapterUp, $gatewayOk, $wanOk, $script:LinkFailStreak, $FailuresBeforeRecovery)

        $elapsedSinceStart = ((Get-Date) - $script:StartTime).TotalSeconds
        if ($elapsedSinceStart -lt $StartupGraceSeconds) {
            # A process that was just (re)started hasn't proven anything yet -- routes/DNS may still be
            # settling, or this restart itself is a symptom of something else. Never let a fresh instance
            # race straight into the most destructive action. Reset the streak so it only starts counting
            # once the grace period has actually elapsed.
            Write-Log 'INFO' ("Within startup grace period ({0:N0}s of {1}s); not escalating to adapter reconnect yet." -f $elapsedSinceStart, $StartupGraceSeconds)
            $script:LinkFailStreak = 0
            return
        }

        if ($script:LinkFailStreak -ge $FailuresBeforeRecovery) {
            $since = (Get-Date) - $script:LastLinkRecovery
            if ($since.TotalSeconds -lt $LinkCooldownSeconds) {
                Write-Log 'INFO' ("Link recovery in cooldown ({0:N0}s of {1}s); skipping NIC cycle" -f $since.TotalSeconds, $LinkCooldownSeconds)
            } else {
                Write-Log 'DIAG' 'Sustained adapter-down or both-public-targets-unreachable. Escalating to adapter reconnect.'
                Invoke-FlushDns | Out-Null
                Reset-WlanAdapter
                $script:LastLinkRecovery = Get-Date
            }
            $script:LinkFailStreak = 0
        }
        return   # link is down; proxy/node diagnosis is meaningless until it's back
    }

    $script:LinkFailStreak = 0

    if (-not $dnsOk) {
        Write-Log 'WARN' 'WAN reachable but DNS resolution failing. Flushing DNS.'
        Invoke-FlushDns | Out-Null
    }

    if (-not $proxyPortOk) {
        $since = (Get-Date) - $script:LastProxyRecovery
        if ($since.TotalSeconds -lt $ProxyCooldownSeconds) {
            Write-Log 'INFO' ("Proxy recovery in cooldown ({0:N0}s of {1}s); skipping restart" -f $since.TotalSeconds, $ProxyCooldownSeconds)
        } else {
            Write-Log 'DIAG' 'WAN is fine but local proxy mixed-port is not accepting connections. Restarting proxy stack.'
            Restart-ProxyStack
            $script:LastProxyRecovery = Get-Date
        }
        return
    }

    if (-not $mihomoOk) {
        Write-Log 'WARN' 'Proxy port is up but mihomo control API is unreachable (process may be hung). No node-health check possible this pass.'
        return
    }

    # Two ways to conclude the active node is dead:
    #  (1) mihomo's own cached history says so (only reliable if the group was re-tested recently);
    #  (2) a REAL request through the proxy fails even though direct WAN (Layer 2) is fine -- this
    #      is the one that catches the 24h-stale-cache case, i.e. the "must click refresh" symptom.
    $proxyEgressOk   = Test-ProxyInternet
    $unhealthyGroups = Get-UnhealthyMihomoGroups
    $egressForced    = $false
    if (-not $proxyEgressOk) {
        # WAN is up, port is open, API answers -- but nothing actually gets out through the proxy.
        # The selected node is dead with a stale-good cached delay. Don't trust history: force a
        # fresh re-test + switch on every in-use group (what clicking "refresh" in Clash does).
        Write-Log 'WARN' 'Direct WAN is fine and proxy port is open, but a real request THROUGH the proxy failed. Active node is dead (cached delay is stale-good). Forcing a re-test/switch on all groups.'
        $allGroups = Get-AllProxyGroups
        if ($allGroups.Count -gt 0) {
            $unhealthyGroups = @($unhealthyGroups + $allGroups | Select-Object -Unique)
            $egressForced = $true
        }
    }

    if ($unhealthyGroups.Count -gt 0) {
        $since = (Get-Date) - $script:LastNodeFix
        # When real egress is broken, ignore the node-fix cooldown -- the user has no internet right
        # now; waiting 60s just to be polite would mean 60s of downtime. Cooldown still applies to
        # the softer history-only signal so we don't thrash on a merely-slow node.
        if (-not $egressForced -and $since.TotalSeconds -lt $NodeFixCooldownSeconds) {
            Write-Log 'INFO' ("Node-fix in cooldown ({0:N0}s of {1}s); {2} unhealthy group(s) waiting: {3}" -f $since.TotalSeconds, $NodeFixCooldownSeconds, $unhealthyGroups.Count, ($unhealthyGroups -join ', '))
        } else {
            Write-Log 'DIAG' ("{0} proxy group(s) need a node switch: {1}. Re-testing and switching, not touching the NIC or restarting processes." -f $unhealthyGroups.Count, ($unhealthyGroups -join ', '))
            foreach ($g in $unhealthyGroups) { Repair-MihomoGroup -GroupName $g }
            $script:LastNodeFix = Get-Date
        }
        return
    }

    Write-Log 'OK' 'Link + WAN + proxy port + proxy egress + mihomo API + active nodes all healthy'
}

# --- main loop ---------------------------------------------------------------
Initialize-MihomoApi | Out-Null
Write-Log 'START' ("Watchdog v2 started (interval=${IntervalSeconds}s, gateway=$Gateway, wanTargets=$($PublicWanTargets -join ','), proxy=${ProxyHost}:${ProxyPort}, mihomo=$($script:MihomoBase), regReset=$($AllowProxyRegistryReset.IsPresent))")

try {
    if ($RunOnce) { Invoke-CheckPass; Write-Log 'STOP' 'RunOnce complete'; return }

    while ($true) {
        Invoke-CheckPass
        Start-Sleep -Seconds $IntervalSeconds
    }
} finally {
    Write-Log 'STOP' 'Watchdog stopped'
    if ($script:Mutex) { $script:Mutex.ReleaseMutex(); $script:Mutex.Dispose() }
}
